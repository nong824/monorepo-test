{
  "name": "repo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @brianzhu/web dev",
    "dev:admin": "pnpm --filter @brianzhu/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "release": "multi-semantic-release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anolilab/multi-semantic-release": "^4.4.23",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.30.2"
}